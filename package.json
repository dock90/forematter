{
	"name": "forematter",
	"version": "0.1.0",
	"description": "Fast, safe, zero-dependency front matter parser. A modern replacement for gray-matter.",
	"keywords": ["front-matter", "frontmatter", "gray-matter", "yaml", "markdown", "parser"],
	"license": "MIT",
	"author": "Edward Darling",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dock90/forematter.git"
	},
	"homepage": "https://github.com/dock90/forematter#readme",
	"bugs": "https://github.com/dock90/forematter/issues",
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test \"test/*.test.js\"",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	}
}
